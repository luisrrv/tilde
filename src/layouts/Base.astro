---
import '../styles/global.css';
import { supabase } from '../lib/supabase';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Absolute URLs for OG/twitter tags -- Astro.site is configured in
// astro.config.mjs (currently rodluis.com; will point at whatever
// domain is live post-cutover, blueprint.md §19 step 19).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL('/og-image.png', Astro.site).href;

// The footer shows the *build* time, not any content's timestamp — see
// §4 of blueprint.md. It doubles as the keep-alive's liveness signal:
// if this date stops advancing, the scheduled rebuild has stopped
// running. Computed once, at build time, deliberately — this is not
// one of the three client-JS pieces the site budgets for (§3).
const buildDate = new Date().toISOString().slice(0, 10);

// Slugs for the terminal's `random` command (§7). Best-effort: this
// runs on every page build, and a hiccup here shouldn't fail the whole
// site — the command just has nothing to offer that day.
let logSlugs: string[] = [];
try {
  const { data } = await supabase.from('logs').select('slug').eq('published', true);
  logSlugs = (data ?? []).map((row) => row.slug as string);
} catch {
  logSlugs = [];
}
---

<!doctype html>
<html lang="en" data-theme="default">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/*
      /sitemap.html (blueprint §4/§5) is a small remaining piece of
      site metadata, not yet built.
    */}
  </head>
  <!--
    you're either reading the source or the console, so: hi.
    there's a sitemap, for what it's worth. /sitemap.html
  -->
  <body>
    <header class="site-header measure">
      <a href="/" class="wordmark" aria-label="home">~</a>
      <nav>
        <a href="/log">log</a>
        <a href="/now">now</a>
      </nav>
      <button
        type="button"
        id="terminal-toggle"
        class="help-tap"
        aria-label="open terminal"
        title="~ works too, if you have a keyboard"
      >
        [ ? ]
      </button>
    </header>

    <div class="measure">
      <slot />

      <footer>
        <p class="rule"></p>
        <p class="under-construction">[ under construction ]</p>
        <p class="meta">last updated: {buildDate} · best viewed with: a browser</p>
      </footer>
    </div>

    <div id="terminal-overlay" class="terminal-overlay" hidden data-log-slugs={JSON.stringify(logSlugs)}>
      <div class="terminal-box" role="dialog" aria-label="terminal">
        <p class="terminal-hint" id="terminal-greeting"></p>
        <p class="terminal-hint">type `help`.</p>
        <div class="terminal-line">
          <span class="terminal-prompt">&gt;</span>
          <input
            type="text"
            id="terminal-input"
            class="terminal-input"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="terminal command input"
          />
        </div>
        <pre id="terminal-output" class="terminal-output" aria-live="polite"></pre>
      </div>
    </div>
  </body>
</html>

<style>
  .under-construction {
    display: inline-block;
    margin: 0 0 0.5em;
    padding: 0.15em 0.5em;
    border: 1px dashed var(--rule);
    color: var(--fg-dim);
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
  }

  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-sm);
  }

  .site-header .wordmark {
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .site-header nav {
    display: flex;
    gap: 0.85rem;
    margin-right: auto;
  }

  .help-tap {
    font: inherit;
    color: var(--fg-dim);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .help-tap:hover,
  .help-tap:focus-visible {
    color: var(--accent);
  }

  .terminal-overlay {
    position: fixed;
    inset: auto 0 0 0;
    display: flex;
    justify-content: center;
    padding: 1rem;
    pointer-events: none;
    z-index: 50;
  }

  .terminal-overlay[hidden] {
    display: none;
  }

  .terminal-overlay:not([hidden]) {
    pointer-events: auto;
  }

  .terminal-box {
    width: 100%;
    max-width: var(--measure);
    background: var(--term-bg);
    color: var(--term-fg);
    border-radius: 4px;
    padding: 0.85rem 1rem;
    font-size: var(--text-sm);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  }

  .terminal-hint {
    margin: 0 0 0.35em;
    color: var(--term-dim);
  }

  .terminal-hint:empty {
    display: none;
  }

  .terminal-line {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .terminal-prompt {
    color: var(--term-dim);
  }

  .terminal-input {
    flex: 1;
    background: none;
    border: none;
    color: var(--term-fg);
    font: inherit;
    caret-color: var(--accent);
  }

  .terminal-input:focus {
    outline: none;
  }

  .terminal-output {
    margin: 0.5em 0 0;
    color: var(--term-fg);
    font-family: var(--font);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    max-height: 30vh;
    overflow-y: auto;
  }

  .terminal-output:empty {
    display: none;
  }
</style>

<script>
  // Client-JS budget items 1 + 2 (§3): the `~` terminal overlay (§7)
  // and the localStorage first-visit check (§15) share this single
  // inline script, present on every page via this layout. Both are
  // progressive enhancement — with JS off the terminal simply never
  // opens (conventional nav still works) and the first-visit copy,
  // wherever it appears, is what everyone sees.
  //
  // Two independent flags, not one shared one: visiting the homepage
  // and opening the terminal for the first time are separate personal
  // milestones, and using up one shouldn't use up the other.
  const GREETING_SEEN_KEY = 'tilde:seen-greeting';
  const TERMINAL_SEEN_KEY = 'tilde:seen-terminal';

  function hasSeen(key: string): boolean {
    try {
      return localStorage.getItem(key) === '1';
    } catch {
      return false; // storage blocked — the honest fallback is "first visit"
    }
  }

  function markSeen(key: string) {
    try {
      localStorage.setItem(key, '1');
    } catch {
      // storage blocked; nothing to persist, every visit reads as "first"
    }
  }

  // ---- first-visit greeting swap, wherever [data-greeting] appears ----
  const greeting = document.querySelector<HTMLElement>('[data-greeting]');
  if (greeting) {
    if (hasSeen(GREETING_SEEN_KEY)) {
      const returnText = greeting.dataset.return;
      if (returnText) greeting.textContent = returnText;
    }
    // else: the first-visit copy is already sitting in the HTML —
    // the correct no-JS fallback too.
    markSeen(GREETING_SEEN_KEY);
  }

  // ---- terminal overlay ----
  const overlay = document.getElementById('terminal-overlay');
  const toggle = document.getElementById('terminal-toggle');
  const input = document.getElementById('terminal-input') as HTMLInputElement | null;
  const output = document.getElementById('terminal-output');
  const greetingLine = document.getElementById('terminal-greeting');

  const slugsRaw = overlay?.dataset.logSlugs;
  let logSlugs: string[] = [];
  try {
    logSlugs = slugsRaw ? JSON.parse(slugsRaw) : [];
  } catch {
    logSlugs = [];
  }

  const COMMANDS = ['help', 'log', 'now', 'stuff', 'lab', 'work', 'random', 'clear'];

  function isTyping(target: EventTarget | null) {
    const el = target as HTMLElement | null;
    return el?.tagName === 'INPUT' || el?.tagName === 'TEXTAREA' || !!el?.isContentEditable;
  }

  function openTerminal() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    if (greetingLine) {
      greetingLine.textContent = hasSeen(TERMINAL_SEEN_KEY) ? '' : 'you found it.';
    }
    markSeen(TERMINAL_SEEN_KEY);
    if (output) output.textContent = '';
    input.value = '';
    input.focus();
  }

  function closeTerminal() {
    if (!overlay || !input) return;
    overlay.hidden = true;
    input.blur();
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === '~' && !isTyping(e.target) && (!overlay || overlay.hidden)) {
      e.preventDefault();
      openTerminal();
    } else if (e.key === 'Escape' && overlay && !overlay.hidden) {
      closeTerminal();
    }
  });

  toggle?.addEventListener('click', () => {
    if (!overlay || overlay.hidden) {
      openTerminal();
    } else {
      closeTerminal();
    }
  });

  function print(line: string) {
    if (output) output.textContent = line;
  }

  function runCommand(raw: string) {
    const cmd = raw.trim().toLowerCase();
    if (!cmd) return;

    switch (cmd) {
      case 'help':
        print(`${COMMANDS.join('  ')}\n\nprobably writing code that didn't need to exist.`);
        break;
      case 'log':
        window.location.href = '/log';
        break;
      case 'now':
        window.location.href = '/now';
        break;
      case 'stuff':
      case 'lab':
        print(`${cmd} isn't built yet.`);
        break;
      case 'work':
        window.location.href = 'https://lrod.dev';
        break;
      case 'random':
        if (logSlugs.length === 0) {
          print('nothing to pick from yet.');
        } else {
          const pick = logSlugs[Math.floor(Math.random() * logSlugs.length)];
          window.location.href = `/log/${pick}`;
        }
        break;
      case 'clear':
        closeTerminal();
        break;
      default:
        print(`command not found: ${cmd}`);
    }
  }

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const value = input.value;
      input.value = '';
      runCommand(value);
    }
  });
</script>
