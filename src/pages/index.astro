---
import Base from '../layouts/Base.astro';
import { supabase } from '../lib/supabase';
import { renderMarkdown } from '../lib/markdown';
import TokyoStatus from '../components/TokyoStatus.astro';

interface LogRow {
  slug: string;
  title: string | null;
  body: string;
  created_at: string;
}

// The homepage's only dynamic piece: the single latest published
// entry, per §5 ("latest log entry") and the §6 tone example. Same
// build-time, RLS-gated read as /log itself.
const { data, error } = await supabase
  .from('logs')
  .select('slug, title, body, created_at')
  .eq('published', true)
  .order('created_at', { ascending: false })
  .limit(1);

if (error) {
  throw new Error(`Failed to fetch latest log for homepage: ${error.message}`);
}

const latest = (data?.[0] ?? null) as LogRow | null;

const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}); // en-CA gives YYYY-MM-DD, matching §9
---

<Base title="~luis" description="Personal site and notebook.">
  {/* hello -> where i am right now -> what i wrote -> bye */}
  <h1 class="greeting" data-greeting data-return="hello, again."><span data-greeting-text>well, hello.</span><span class="cursor" data-greeting-cursor aria-hidden="true"></span></h1>
  <TokyoStatus />

  <div class="ascii-rule"></div>

  {latest ? (
    <section>
      <p class="meta">
        latest log<span class="sep" aria-hidden="true">&middot;</span><time datetime={latest.created_at}>{dateFormatter.format(new Date(latest.created_at))}</time>
      </p>
      <div class="log-body" set:html={renderMarkdown(latest.body)} />
      <p class="meta"><a class="home-link" href="/log">more logs &rarr;</a></p>
    </section>
  ) : (
    <p class="meta">nothing published yet. <a href="/log">the log</a> will fill in once something is.</p>
  )}

  <div class="ascii-rule"></div>

  <p class="meta">this page doesn't want anything from you.</p>

  {/* ↗ (+ U+FE0E so iOS keeps it as text) = leaves the site; → = stays on it */}
  <p class="meta"><a class="home-link" href="https://lrod.dev">work stuff &#x2197;&#xFE0E;</a></p>

</Base>

<style>
  .greeting {
    white-space: pre-line;
    font-size: var(--text-lg);
    letter-spacing: normal;
    margin-bottom: 0.5em;
  }

  /* the greeting's cursor -- hidden until TokyoStatus's intro turns it
     on, then handed off to the status line after a beat, so it never
     sits there blinking forever on an otherwise static page */
  .greeting .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: var(--accent);
    margin-left: 0.05em;
    vertical-align: -0.15em;
    visibility: hidden;
  }

  .greeting .cursor.blinking {
    visibility: visible;
    animation: greeting-cursor-blink 0.9s step-end infinite;
  }

  @keyframes greeting-cursor-blink {
    50% { opacity: 0; }
  }

  .sep {
    margin-inline: 0.5em;
  }

  /* the two content links: accent from the start (accent = you can
     click this), arrow after the text. Keeps the site's quiet
     underline, which picks up the accent on hover like every link. */
  .home-link {
    color: var(--accent);
  }

  .home-link:hover,
  .home-link:focus-visible {
    text-decoration-color: currentColor;
  }

  .log-body :global(p:last-child) {
    margin-bottom: 0.25em;
  }
</style>
