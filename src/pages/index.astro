---
import Base from '../layouts/Base.astro';

// A swatch of every color token, read from tokens.css by name — the
// page prints the token names, never a hex value (that stays inside
// tokens.css, which this specimen exists to prove).
const swatches = [
  { name: '--bg', role: 'page background' },
  { name: '--fg', role: 'body text' },
  { name: '--fg-dim', role: 'metadata, dim text' },
  { name: '--rule', role: 'separators, borders' },
  { name: '--accent', role: 'status, focus, used sparingly' },
  { name: '--term-bg', role: 'terminal overlay background' },
  { name: '--term-fg', role: 'terminal overlay text' },
  { name: '--term-dim', role: 'terminal overlay dim text' },
];
---

<Base
  title="tilde — type specimen"
  description="Temporary placeholder for the tilde design system. Not the real homepage."
>
  <p class="meta">
    ⚠ this is a temporary type specimen for Task 01, not the real
    homepage (blueprint.md §6). It exists so the token layer and type
    scale are reviewable on a preview URL before any real pages are built.
  </p>

  <hr />

  <h1>tilde — design system specimen</h1>

  <p class="meta">
    this line lives inside <code>.measure</code>, capped at
    <code>var(--measure)</code> (64ch) — mono runs wide, so this is the
    comfortable reading width for the whole site.
  </p>

  <div class="ascii-rule">-----------------------------------------------</div>

  <section>
    <h2>type scale</h2>
    <p style="font-size: var(--text-lg);">--text-lg — 1.125rem, page headings (not bold, letterspaced)</p>
    <p style="font-size: var(--text-base);">--text-base — 1rem, body copy at this weight and line-height</p>
    <p style="font-size: var(--text-sm);" class="meta">--text-sm — 0.8125rem, metadata / labels / the help hint</p>
  </section>

  <div class="ascii-rule">-----------------------------------------------</div>

  <section>
    <h2>links &amp; focus</h2>
    <p>
      an inline <a href="#">underlined link</a> — hover or tab to it to
      see the accent color and focus ring.
    </p>
  </section>

  <div class="ascii-rule">-----------------------------------------------</div>

  <section>
    <h2>token swatches</h2>
    <ul class="swatch-list">
      {swatches.map((token) => (
        <li class="swatch-row">
          <span
            class="swatch"
            style={`background: var(${token.name}); border: 1px solid var(--rule);`}
          ></span>
          <code>{token.name}</code>
          <span class="meta">— {token.role}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .swatch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .swatch-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .swatch {
    display: inline-block;
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
  }
</style>
