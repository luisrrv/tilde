---
import Base from '../layouts/Base.astro';
import { supabase } from '../lib/supabase';
import { renderMarkdown } from '../lib/markdown';

interface LogRow {
  slug: string;
  title: string | null;
  body: string;
  created_at: string;
}

// The homepage's only dynamic piece: the single latest published
// entry, per §5 ("latest log entry") and the §6 tone example. Same
// build-time, RLS-gated read as /log itself.
const { data, error } = await supabase
  .from('logs')
  .select('slug, title, body, created_at')
  .eq('published', true)
  .order('created_at', { ascending: false })
  .limit(1);

if (error) {
  throw new Error(`Failed to fetch latest log for homepage: ${error.message}`);
}

const latest = (data?.[0] ?? null) as LogRow | null;

const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}); // en-CA gives YYYY-MM-DD, matching §9
---

<Base title="~luis" description="Personal site and notebook.">
  <p class="greeting" data-greeting data-return={`you again.\nsame as before, mostly.`}>{`someone who isn't me.\nwell, come in.`}</p>

  <div class="ascii-rule">-----------------------------------------------</div>

  {latest ? (
    <section>
      <p class="meta">latest:</p>
      <p class="meta">
        <time datetime={latest.created_at}>{dateFormatter.format(new Date(latest.created_at))}</time>
      </p>
      <div class="log-body" set:html={renderMarkdown(latest.body)} />
      <p class="meta"><a href="/log">&rarr; more logs</a></p>
    </section>
  ) : (
    <p class="meta">nothing published yet. <a href="/log">the log</a> will fill in once something is.</p>
  )}

  <div class="ascii-rule">-----------------------------------------------</div>

  <p class="meta">this page doesn't want anything from you.</p>

  <p class="meta">work stuff &rarr; <a href="https://lrod.dev">lrod.dev</a></p>

  {/* §4 Web 1.0 accents: a CSS-only marquee (no JS) and one restrained
      88x31-style badge, in the format's real dimensions. Both purely
      decorative. */}
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      marquee tag not supported anymore. this is the tribute version.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      marquee tag not supported anymore. this is the tribute version.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    </div>
  </div>

  <div class="badge-88x31" aria-hidden="true">
    <span>~luis</span>
    <span>since '26</span>
  </div>
</Base>

<style>
  .greeting {
    white-space: pre-line;
    font-size: var(--text-lg);
  }

  .log-body :global(p:last-child) {
    margin-bottom: 0.25em;
  }

  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.4em 0;
    margin: 1.5em 0;
  }

  .marquee-track {
    display: inline-block;
    white-space: nowrap;
    font-size: var(--text-sm);
    color: var(--fg-dim);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee-scroll 16s linear infinite;
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .badge-88x31 {
    width: 88px;
    height: 31px;
    border: 1px solid var(--rule);
    background: var(--bg);
    color: var(--fg-dim);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-align: center;
    user-select: none;
  }
</style>
