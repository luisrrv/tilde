---
import Base from '../layouts/Base.astro';
import { supabase } from '../lib/supabase';
import { renderMarkdown } from '../lib/markdown';

interface LogRow {
  slug: string;
  title: string | null;
  body: string;
  created_at: string;
}

// The homepage's only dynamic piece: the single latest published
// entry, per §5 ("latest log entry") and the §6 tone example. Same
// build-time, RLS-gated read as /log itself.
const { data, error } = await supabase
  .from('logs')
  .select('slug, title, body, created_at')
  .eq('published', true)
  .order('created_at', { ascending: false })
  .limit(1);

if (error) {
  throw new Error(`Failed to fetch latest log for homepage: ${error.message}`);
}

const latest = (data?.[0] ?? null) as LogRow | null;

const dateFormatter = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}); // en-CA gives YYYY-MM-DD, matching §9
---

<Base title="~luis" description="Personal site and notebook.">
  <p class="greeting" data-greeting data-return="hello, again."><span data-greeting-text>well, hello.</span><span class="cursor" data-greeting-cursor aria-hidden="true"></span></p>

  <div class="ascii-rule"></div>

  {latest ? (
    <section>
      <p class="meta">latest:</p>
      <p class="meta">
        <time datetime={latest.created_at}>{dateFormatter.format(new Date(latest.created_at))}</time>
      </p>
      <div class="log-body" set:html={renderMarkdown(latest.body)} />
      <p class="meta"><a href="/log">&rarr; more logs</a></p>
    </section>
  ) : (
    <p class="meta">nothing published yet. <a href="/log">the log</a> will fill in once something is.</p>
  )}

  <div class="ascii-rule"></div>

  <p class="meta">this page doesn't want anything from you.</p>

  <p class="meta">work stuff &rarr; <a href="https://lrod.dev">lrod.dev</a></p>

</Base>

<style>
  .greeting {
    white-space: pre-line;
    font-size: var(--text-lg);
  }

  /* the erase/type cursor -- hidden until the transition script turns
     it on, and removed again once "notes, below." has settled, so it
     never sits there blinking forever on an otherwise static page */
  .greeting .cursor {
    display: inline-block;
    width: 0.5em;
    height: 1em;
    background: currentColor;
    margin-left: 0.05em;
    vertical-align: -0.15em;
    visibility: hidden;
  }

  .greeting .cursor.blinking {
    visibility: visible;
    animation: greeting-cursor-blink 0.9s step-end infinite;
  }

  @keyframes greeting-cursor-blink {
    50% { opacity: 0; }
  }

  .log-body :global(p:last-child) {
    margin-bottom: 0.25em;
  }
</style>
