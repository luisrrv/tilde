---
import Base from '../layouts/Base.astro';
import { supabase } from '../lib/supabase';
import { renderMarkdown } from '../lib/markdown';

// Small experiments and toys (blueprint §5), published from /admin
// like logs and now. Build-time, RLS-gated read: only published rows.
interface LabRow {
  name: string;
  tagline: string;
  story: string; // markdown, same renderer as logs
  url: string;
  source_url: string | null;
  made: string; // date, first of the month -> shown as YYYY-MM
}

const { data, error } = await supabase
  .from('lab')
  .select('name, tagline, story, url, source_url, made')
  .eq('published', true)
  .order('made', { ascending: false })
  .order('created_at', { ascending: false });

if (error) {
  throw new Error(`Failed to fetch lab entries: ${error.message}`);
}

const experiments = (data ?? []) as LabRow[];
---

<Base title="lab — ~luis" description="Small experiments, toys and playful code.">
  <h1>lab</h1>
  <p class="meta">small experiments, useless tools, playful code.</p>

  <div class="ascii-rule"></div>

  {experiments.length === 0 && <p class="meta">nothing here yet.</p>}

  {experiments.map((x, i) => (
    <>
      <article class="experiment">
        <h2>{x.name}</h2>
        {x.tagline && <p class="tagline">{x.tagline}</p>}
        {x.story && <div class="story log-body" set:html={renderMarkdown(x.story)} />}
        <p class="meta">
          <a href={x.url}>[ open &rarr; ]</a>
          {x.source_url && <> &nbsp;<a href={x.source_url}>source</a></>}
          &nbsp;· {x.made.slice(0, 7)}
        </p>
      </article>
      {i < experiments.length - 1 && <div class="ascii-rule"></div>}
    </>
  ))}
</Base>

<style>
  .experiment {
    margin-bottom: 1.5em;
  }
  .experiment h2 {
    font-size: var(--text-lg);
    margin-bottom: 0.15em;
  }
  .tagline {
    color: var(--fg-dim);
    margin-top: 0;
  }
</style>
