# Copy to .env for local dev. Never commit the real .env (already
# gitignored). The PUBLIC_ prefix is required by Astro/Vite so /admin's
# client-side bundle can read these too — that's fine, the anon key is
# meant to be public (blueprint.md §13).
#
# Set these same two in Netlify's env vars as well (Site settings →
# Environment variables) — /log and /now read them at build time.

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
